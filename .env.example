# =============================================================================
# RoadSentinel Studio v3.0 — Configuration Environment Template
# Copy to `.env` to customize runtime settings.
# =============================================================================

# Server Binding
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=info

# Model & Detection Weights
MODEL_WEIGHTS_PATH=weights/session4_best.pt
PHASE13_WEIGHTS_PATH=experiments/phase_13_output/phase13_best.pt

# Active Foveation Engine Parameters
CONF_TRIAGE_THRESHOLD=0.35
IOU_WBF_THRESHOLD=0.55
FOV_SCALE_FACTOR=2.5

# Optional Cloud Multimodal Reasoner (Nebius / Qwen2-VL)
NEBIUS_API_KEY=
NEBIUS_API_URL=https://api.studio.nebius.ai/v1
